<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
 <xs:simpleType name="id"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="512"/><xs:pattern value="[A-Za-z0-9][A-Za-z0-9_.:@#+-]*"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="tipo"><xs:restriction base="xs:string"><xs:enumeration value="subject"/><xs:enumeration value="topic"/><xs:enumeration value="task"/><xs:enumeration value="series"/><xs:enumeration value="event"/><xs:enumeration value="occurrence"/><xs:enumeration value="source"/><xs:enumeration value="availability"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="hora"><xs:restriction base="xs:string"><xs:pattern value="([01][0-9]|2[0-3]):[0-5][0-9]"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="timestamp"><xs:restriction base="xs:dateTime"><xs:pattern value=".*(Z|[+-][0-9]{2}:[0-9]{2})"/></xs:restriction></xs:simpleType>
 <xs:simpleType name="fechaOHora"><xs:union memberTypes="xs:date timestamp"/></xs:simpleType>
 <xs:element name="universidad"><xs:complexType><xs:sequence><xs:element name="elemento" minOccurs="1" maxOccurs="5000"><xs:complexType><xs:choice minOccurs="0" maxOccurs="64">
  <xs:element name="title" type="xs:string"/><xs:element name="subject" type="xs:string"/><xs:element name="topic" type="xs:string"/><xs:element name="task" type="xs:string"/><xs:element name="evaluation" type="xs:string"/>
  <xs:element name="category"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="class"/><xs:enumeration value="exam"/><xs:enumeration value="study"/><xs:enumeration value="availability"/></xs:restriction></xs:simpleType></xs:element>
  <xs:element name="uid" type="xs:string"/><xs:element name="description" type="xs:string"/><xs:element name="location" type="xs:string"/><xs:element name="objective" type="xs:string"/><xs:element name="references" type="xs:string"/><xs:element name="criterion" type="xs:string"/>
  <xs:element name="dependencies"><xs:complexType><xs:sequence><xs:element name="ref" type="id" minOccurs="0" maxOccurs="100"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="start" type="timestamp"/><xs:element name="finish" type="timestamp"/><xs:element name="date" type="xs:date"/><xs:element name="dateEnd" type="xs:date"/>
  <xs:element name="rrule" type="xs:string"/><xs:element name="exdates"><xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="500"><xs:element name="at" type="timestamp"/><xs:element name="on" type="xs:date"/></xs:choice></xs:sequence></xs:complexType></xs:element>
  <xs:element name="series" type="xs:string"/><xs:element name="recurrenceId" type="fechaOHora"/><xs:element name="source" type="xs:string"/><xs:element name="path" type="xs:string"/><xs:element name="color"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="#[a-fA-F0-9]{6}"/></xs:restriction></xs:simpleType></xs:element>
  <xs:element name="days" type="xs:string"/><xs:element name="fromTime" type="hora"/><xs:element name="toTime" type="hora"/><xs:element name="reserve" type="xs:boolean"/><xs:element name="cancelled" type="xs:boolean"/><xs:element name="exception" type="xs:string"/><xs:element name="tags" type="xs:string"/>
 </xs:choice><xs:attribute name="id" type="id" use="required"/><xs:attribute name="tipo" type="tipo" use="required"/><xs:attribute name="accion" default="actualizar"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="actualizar"/><xs:enumeration value="archivar"/><xs:enumeration value="reactivar"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType></xs:element></xs:sequence>
 <xs:attribute name="version" use="required" fixed="1"/><xs:attribute name="paquete" type="id" use="required"/><xs:attribute name="revision" type="xs:positiveInteger" use="required"/><xs:attribute name="zona" use="required" fixed="Europe/Madrid"/><xs:attribute name="fechaRevision" type="xs:date" use="required"/>
 </xs:complexType><xs:unique name="idsUnicos"><xs:selector xpath="elemento"/><xs:field xpath="@id"/></xs:unique></xs:element>
</xs:schema>
